---
// Logo de Veterinaria Trébol: isotipo SVG + nombre en texto
interface Props { class?: string; dark?: boolean }
const { class: className = '', dark = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5 font-display font-extrabold tracking-tight leading-none', dark ? 'text-white' : 'text-brand-ink', className]}>
  <svg class="h-10 w-10 shrink-0" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="11" fill="#22314F"/><g fill="#F4C3AE"><circle cx="20" cy="13.5" r="6"/><circle cx="13.2" cy="21.2" r="6"/><circle cx="26.8" cy="21.2" r="6"/></g><circle cx="20" cy="19.2" r="3.2" fill="#22314F"/><path d="M20 22.5c0 4 .8 6.5 3 9" fill="none" stroke="#F4C3AE" stroke-width="2.6" stroke-linecap="round"/></svg>
  <span class="text-xl md:text-2xl">Veterinaria <span class={dark ? 'text-trebol-300' : 'text-brand-coral'}>Trébol</span></span>
</span>
