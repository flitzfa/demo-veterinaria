---
// Header de Veterinaria Trébol con aviso de demo
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import Logo from './Logo.astro';
import { business } from '../config/business';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-trebol-100 shadow-sm transition-all duration-300">
  <p class="bg-brand-ink text-white text-xs leading-snug text-center px-4 py-2">
    Demo de flitzfa: negocio ficticio, los datos son de ejemplo.{' '}
    <a href={business.flitzfaUrl} target="_blank" rel="noopener" class="font-semibold underline underline-offset-2 hover:text-trebol-200">flitzfa.com.ar</a>
  </p>
  <nav class="container-main" aria-label="Navegación principal">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href={import.meta.env.BASE_URL + '#inicio'} class="shrink-0" aria-label={business.fullName + ' - Inicio'}>
        <Logo />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden xl:flex items-center gap-8">
        <a href="#inicio" class="text-sm font-medium text-gray-600 hover:text-brand-coral transition-colors">Inicio</a>
        <a href="#servicios" class="text-sm font-medium text-gray-600 hover:text-brand-coral transition-colors">Servicios</a>
        <a href="#horarios" class="text-sm font-medium text-gray-600 hover:text-brand-coral transition-colors">Horarios</a>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" data-wa={business.whatsappMessages.turno} class="btn-whatsapp hidden xl:flex whitespace-nowrap px-4 xl:px-6">
          <WhatsAppIcon class="w-5 h-5" />
          Pedir turno por WhatsApp
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button type="button" class="xl:hidden p-2 rounded-xl text-gray-600 hover:bg-trebol-50 transition-colors" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="xl:hidden hidden pb-4 border-t border-trebol-100 animate-slide-down">
      <div class="mt-4 rounded-2xl border border-trebol-100 bg-white shadow-card p-4">
        <div class="flex flex-col gap-4">
          <a href="#inicio" class="text-base font-medium text-gray-700 hover:text-brand-coral transition-colors">Inicio</a>
          <a href="#servicios" class="text-base font-medium text-gray-700 hover:text-brand-coral transition-colors">Servicios</a>
          <a href="#horarios" class="text-base font-medium text-gray-700 hover:text-brand-coral transition-colors">Horarios</a>
          <div class="flex flex-col gap-3 pt-4 border-t border-trebol-100">
            <button type="button" data-wa={business.whatsappMessages.turno} class="btn-whatsapp w-full justify-center">
              <WhatsAppIcon class="w-5 h-5" />
              Pedir turno por WhatsApp
            </button>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.querySelector('header button[aria-controls="mobile-menu"]');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.querySelector('header');

  const setMenuState = (isOpen: boolean) => {
    mobileMenu?.classList.toggle('hidden', !isOpen);
    menuBtn?.setAttribute('aria-expanded', isOpen.toString());

    const svg = menuBtn?.querySelector('svg');
    if (svg) {
      svg.innerHTML = isOpen
        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>'
        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>';
    }
  };

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('hidden');
      setMenuState(isOpen);
    });

    // Cerrar menú al tocar un enlace o el botón de WhatsApp
    mobileMenu.querySelectorAll('a, button').forEach(link => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuState(false);
      }
    });
  }

  // Header scroll effect
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shadow-card', window.pageYOffset > 100);
  });
</script>

<style>
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-slide-down {
    animation: slideDown 0.3s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-down {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
