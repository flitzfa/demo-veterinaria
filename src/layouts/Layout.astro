---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '../styles/global.css';
// Layout base de Veterinaria Trébol (negocio ficticio, demo de flitzfa)
import { business } from '../config/business';
import DemoWhatsApp from '../components/DemoWhatsApp.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = business.seo.title,
  description = business.seo.description,
  image = 'og-image.jpg',
} = Astro.props;

const siteUrl = (Astro.site?.toString() || business.siteUrl).replace(/\/+$/, '') + '/';
const ogImage = siteUrl + image.replace(/^\/+/, '');
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="manifest" href={import.meta.env.BASE_URL + 'manifest.json'} />
    <meta name="theme-color" content="#22314f" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Perro pomerania en una mesa de consultorio" />
    <meta property="og:site_name" content={business.fullName} />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org: negocio ficticio, sin dirección ni teléfono -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VeterinaryCare",
      "name": business.fullName,
      "description": "Veterinaria ficticia. Demo de web para veterinaria hecha por flitzfa; los datos son de ejemplo.",
      "url": siteUrl,
      "areaServed": business.area,
      "creator": { "@type": "Person", "name": "flitzfa", "url": business.flitzfaUrl }
    })} />
  </head>
  <body class="font-sans text-gray-900 antialiased bg-brand-cream">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 btn-primary">Saltar al contenido principal</a>
    
    <!-- Header slot -->
    <slot name="header" />
    
    <!-- Main content landmark -->
    <main id="main-content" class="min-h-screen">
      <slot name="main" />
    </main>
    
    <!-- Footer slot -->
    <slot name="footer" />

    <DemoWhatsApp />
  </body>
</html>

<style>
  /* Ensure smooth scrolling works with fixed header */
  html {
    scroll-padding-top: 7rem;
  }
  
  @media (max-width: 768px) {
    html {
      scroll-padding-top: 6.5rem;
    }
  }
</style>